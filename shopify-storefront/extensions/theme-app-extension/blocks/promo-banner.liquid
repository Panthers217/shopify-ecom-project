{% assign bg = block.settings.bg_color %}
{% assign text = block.settings.text_color %}
{% assign button_bg = block.settings.button_bg_color %}
{% assign button_text = block.settings.button_text_color %}

<div
  class="copilot-promo-banner"
  style="
    --bg: {{ bg }};
    --text: {{ text }};
    --btn-bg: {{ button_bg }};
    --btn-text: {{ button_text }};
  "
>
  <div class="copilot-promo-banner__inner page-width">
    <div class="copilot-promo-banner__content">
      {% if block.settings.eyebrow != blank %}
        <p class="copilot-promo-banner__eyebrow">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="copilot-promo-banner__heading">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.body != blank %}
        <div class="copilot-promo-banner__body rte">{{ block.settings.body }}</div>
      {% endif %}
    </div>

    {% if block.settings.button_label != blank and block.settings.button_link != blank %}
      <a class="copilot-promo-banner__button" href="{{ block.settings.button_link }}">
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

<style>
  .copilot-promo-banner {
    background: var(--bg);
    color: var(--text);
    border-radius: 14px;
    margin: 20px 0;
    overflow: hidden;
  }

  .copilot-promo-banner__inner {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    padding: 24px;
  }

  .copilot-promo-banner__content {
    max-width: 720px;
  }

  .copilot-promo-banner__eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .copilot-promo-banner__heading {
    margin: 0 0 10px;
    font-size: clamp(20px, 3vw, 32px);
    line-height: 1.15;
  }

  .copilot-promo-banner__body {
    margin: 0;
    opacity: 0.92;
  }

  .copilot-promo-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-weight: 600;
    white-space: nowrap;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .copilot-promo-banner__button:hover {
    transform: translateY(-1px);
    opacity: 0.95;
  }

  @media (max-width: 749px) {
    .copilot-promo-banner__inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Promo banner",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Free shipping on orders over $75"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Refresh your wardrobe with new arrivals and seasonal essentials.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#111827"
    }
  ]
}
{% endschema %}
